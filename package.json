{
  "name": "cultogen-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "start": "node dist-server/server.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.559.0",
    "nodemailer": "^10.0.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
